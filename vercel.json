{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/*.py": {
      "excludeFiles": "{docs/**,starter_kit/**,apps/web/**,tests/**,evals/**,infra/**,.github/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(auth|jobs|proposals|approvals|messages|runs|analytics|settings|health)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
