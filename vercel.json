{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/jobs", "destination": "/api/index.py" },
    { "source": "/jobs/:path*", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/diagnostic", "destination": "/api/index.py" },
    { "source": "/auth", "destination": "/api/index.py" },
    { "source": "/auth/:path*", "destination": "/api/index.py" },
    { "source": "/proposals", "destination": "/api/index.py" },
    { "source": "/proposals/:path*", "destination": "/api/index.py" },
    { "source": "/approvals", "destination": "/api/index.py" },
    { "source": "/approvals/:path*", "destination": "/api/index.py" },
    { "source": "/messages", "destination": "/api/index.py" },
    { "source": "/messages/:path*", "destination": "/api/index.py" },
    { "source": "/runs", "destination": "/api/index.py" },
    { "source": "/runs/:path*", "destination": "/api/index.py" },
    { "source": "/analytics", "destination": "/api/index.py" },
    { "source": "/analytics/:path*", "destination": "/api/index.py" },
    { "source": "/settings", "destination": "/api/index.py" },
    { "source": "/settings/:path*", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
