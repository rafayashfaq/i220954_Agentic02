{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "{apps/api/**,apps/__init__.py,agent/**,rag/**,mcp_servers/**,gigsim/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(auth|jobs|proposals|approvals|messages|runs|analytics|settings|health|diagnostic)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
